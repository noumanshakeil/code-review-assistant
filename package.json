{
  "name": "code-review-assistant",
  "productName": "Code Review Assistant",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered Code Review Assistant & Humanizer — desktop app for Windows (.exe / .msix)",
  "author": "Code Review Assistant",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build && electron-builder --config electron-builder.yml",
    "build:win": "tsc -b && vite build && electron-builder --win --config electron-builder.yml",
    "build:msix": "tsc -b && vite build && electron-builder --win appx --config electron-builder.yml",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "start": "electron .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.9",
    "keytar": "^7.9.0",
    "lucide-react": "^1.47.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
